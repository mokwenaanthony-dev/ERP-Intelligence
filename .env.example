# Copy to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production only (behind HTTPS):
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0

# Local dev uses SQLite. Docker Compose overrides these with PostgreSQL.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Used by docker-compose.yml for the postgres service
POSTGRES_DB=erp_system
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change-me

# Read-only role for BI tools (python manage.py setup_reporting_role) and the Metabase admin
# account created by scripts/metabase_setup.py (http://localhost:3000).
REPORTING_DB_PASSWORD=change-me-too
METABASE_URL=http://localhost:3000
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=change-me-Metabase1

# Neo4j knowledge graph. Docker Compose points the app at bolt://neo4j:7687 itself; leave NEO4J_URI
# unset here so local runs and tests outside Docker keep the graph off. To run the graph tests
# against the Docker Neo4j from your PC: NEO4J_URI=bolt://localhost:7687 pytest
NEO4J_PASSWORD=change-me-Neo4j1
# Avoid $ in any value in this file: Docker Compose reads $name as a variable.

# Demand forecasting service (Wave 8a). Docker Compose starts ml_service and points the ERP at it
# itself; the token must be set here (16+ random characters), or ml_service refuses to start. To use
# the Docker ml_service from Windows: ML_SERVICE_URL=http://localhost:8001 python manage.py run_forecast ...
ML_SERVICE_TOKEN=change-me-to-16-or-more-random-characters

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

LOG_LEVEL=INFO
# LOG_DIR=/var/log/erp
